# Dependencies
node_modules/

# Next.js build output
.next/
out/
*.tsbuildinfo

# Environment — never commit real credentials
.env
.env.local
.env*.local

# Editor / OS
.DS_Store
Thumbs.db

# Vercel
.vercel

# Reference imagery dropped here for local mockups. Never commit.
/images/

# Stitch design export — mockup HTML and docs are tracked; the PNG renders are
# not. They are 9.5MB of the 9.7MB and the HTML reproduces them exactly.
docs/design/stitch-design-system/**/*.png

# Raw reference-photo drop. Same category as /images/ — unlicensed third-party
# photography kept for local mockups, plus an 822MB video that exceeds GitHub's
# per-file limit. Never commit.
/pics/

# Per-machine Claude Code permission allowlist. Machine-specific absolute paths,
# no value to anyone else on the repo.
.claude/settings.local.json

# Impeccable working files: review captures show the stand-in photography, and
# questions/ is a local decision-page server's state.
.impeccable/review/
.impeccable/questions/

# Redesign before/after screenshots: they show the unlicensed stand-in photos.
docs/redesign/baseline/
docs/redesign/after/
# Browser-automation logs.
.playwright-mcp/
