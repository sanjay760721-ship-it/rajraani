{
  "name": "rajraani",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 8080",
    "build": "next build",
    "start": "next start --port 8080",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"sanity/**/*.test.ts\"",
    "lint:headings": "node scripts/lint-headings.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:reset": "node scripts/db-seed.mjs --fresh",
    "taxonomy": "node scripts/build-taxonomy.mjs",
    "taxonomy:check": "node scripts/build-taxonomy.mjs --check",
    "check:taxonomy": "node scripts/check-taxonomy.mjs",
    "check:originality": "node scripts/check-originality.mjs",
    "verify": "npm run taxonomy:check && npm run check:taxonomy && npm run check:originality && npm run test && npm run lint && npm run typecheck && npm run build && npm run lint:headings"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@types/flickity": "^2.2.12",
    "animejs": "^4.5.0",
    "flickity": "^3.0.0",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
