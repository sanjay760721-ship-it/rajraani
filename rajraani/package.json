{
  "name": "rajraani-storefront",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run tokens && next build",
    "start": "next start",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs && git diff --exit-code design/tokens.css lib/tokens.generated.ts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:originality": "node scripts/check-originality.mjs",
    "check:headings": "node scripts/check-headings.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "verify": "npm run tokens:check && npm run check:contrast && npm run check:taxonomy && npm run check:originality && npm run check:headings && npm run typecheck && npm run lint",
    "check:taxonomy": "node scripts/check-taxonomy.mjs"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
