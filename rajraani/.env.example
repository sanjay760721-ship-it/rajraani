# Copy to .env.local and fill in. Never commit .env.local.
#
# With these unset, the app serves the fixture catalogue in
# src/lib/data/fixtures.ts and shows a placeholder banner. Setting them switches
# src/lib/data/catalogue.ts to the Shopify adapter — which is not implemented
# yet and will throw with instructions.

SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-01
