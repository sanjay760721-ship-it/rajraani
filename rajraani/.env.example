# Copy to .env.local and fill in. Never commit .env.local — it is gitignored,
# and a secret committed to git is permanent.
#
# Everything here is optional in development. With none of it set, the app uses
# ./data/rajraani.db and the seeded catalogue.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Where the SQLite file lives. Defaults to ./data/rajraani.db.
# On a host with an ephemeral filesystem this must point at a persistent
# volume, or the catalogue disappears on every deploy.
DATABASE_PATH=

# ---------------------------------------------------------------------------
# Razorpay — not wired up yet
# ---------------------------------------------------------------------------
# The key ID is public and reaches the browser. The secret never leaves the
# server: it signs and verifies payments, so treat it like a password.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set when the payment webhook is configured. Incoming webhooks are verified
# against this signature — without it, anyone who found the URL could mark an
# order as paid.
RAZORPAY_WEBHOOK_SECRET=
