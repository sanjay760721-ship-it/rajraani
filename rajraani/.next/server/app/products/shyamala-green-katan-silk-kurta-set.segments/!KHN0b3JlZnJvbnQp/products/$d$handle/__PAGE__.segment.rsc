ately the lightest one.","spec":{"colour":"Rose pink","technique":"Handwoven moonga ground, tailored; hand-embroidered dupatta","fabric":"Moonga silk","speciality":"Hand-embroidered organza dupatta","note":"Anarkali with churidar and an embroidered organza dupatta."},"provenance":{"workshop":"Sarnath atelier","loom":"Pit loom, moonga ground","weaveTimeWeeks":5,"artisanCount":4},"garmentType":"suit","fabric":"moonga-silk","colourFamily":"pink","zariTypes":["resham"],"motifs":["bel","floral"]}}],"$L30"]}],"$L31"]}]}]
