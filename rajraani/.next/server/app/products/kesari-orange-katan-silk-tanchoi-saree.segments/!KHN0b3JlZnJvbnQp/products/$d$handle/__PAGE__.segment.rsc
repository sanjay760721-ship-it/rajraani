argah, continuous figurative field","fabric":"Pure Katan silk","speciality":"Real zari throughout, with meenakari at the pallu figures","collectionNote":"From Antaraal.","note":"Woven to order."},"provenance":{"workshop":"Madanpura workshop","loom":"Pit loom, jacquard","weaveTimeWeeks":26,"artisanCount":4},"garmentType":"saree","weave":"cutwork","fabric":"katan-silk","colourFamily":"indigo","zariTypes":["real_zari","resham"],"motifs":["bird-animal","jaal","konia","shikargah"],"campaign":"antaraal"}}],"$L1d"]}],"$L1e"]}]}],"$L1f","$L20"]}]]}]
