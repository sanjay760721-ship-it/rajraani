patchLeadDays":[14,18],"images":[{"id":"ksheera-off-white-muslin-cotton-jamdani-suit-1","ratio":"portrait","shot":"on_model_full","alt":"Full-length view of the draped piece: off-white anarkali suit in muslin cotton jamdani with booti motifs","width":3000,"height":4500,"src":"/reference-only/products/ksheera-off-white-muslin-cotton-jamdani-suit/01.webp"},{"id":"ksheera-off-white-muslin-cotton-jamdani-suit-2","ratio":"portrait","shot":"on_model_drape","alt":"Three-quarter view showing the fall of the drape: off-white anarkali suit in muslin cotton jamdani with booti motifs","width":3000,"height":4500,"src":"/reference-only/products/ksheera-off-white-muslin-cotton-jamdani-suit/02.webp"},{"id":"ksheera-off-white-muslin-cotton-jamdani-suit-3","ratio":"portrait","shot":"on_model_detail","alt":"Close view of the border against the body: off-white anarkali suit in muslin cotton jamdani with booti motifs","width":3000,"height":4500,"src":"/reference-only/products/ksheera-off-white-muslin-cotton-jamdani-suit/03.webp"},{"id":"ksheera-off-white-muslin-cotton-jamdani-suit-4","ratio":"portrait","shot":"on_model_movement","alt":"The piece in movement, mid-turn: off-white anarkali suit in muslin cotton jamdani with booti motifs","width":3000,"height":4500,"src":"/reference-only/products/ksheera-off-white-muslin-cotton-jamdani-suit/04.webp"},{"id":"ksheera-off-white-muslin-cotton-jamdani-suit-5","ratio":"portrait","shot":"flat_lay","alt":"The piece laid flat, folded to show body, border and pallu: off-white anarkali suit in muslin cotton jamdani with booti motifs","width":3000,"height":4500,"src":"/reference-only/products/ksheera-off-white-muslin-cotton-jamdani-suit/05.webp"},{"id":"ksheera-off-white-muslin-cotton-jamdani-suit-6","ratio":"square","shot":"detail_weave","alt":"Macro detail of the weave: off-white anarkali suit in muslin cotton jamdani with booti motifs","width":3000,"height":3000,"src":"/reference-only/products/ksheera-off-white-muslin-cotton-jamdani-suit/06.webp"},{"id":"ksheera-off-white-muslin-cotton-jamdani-suit-7","ratio":"square","shot":"detail_weave","alt":"Macro detail of the weave: off-white anarkali suit in muslin cotton jamdani with booti motifs","width":3000,"height":3000,"src":"/reference-only/products/ksheera-off-white-muslin-cotton-jamdani-suit/07.webp"},{"id":"ksheera-off-white-muslin-cotton-jamdani-suit-8","ratio":"square","shot":"detail_weave","alt":"Macro detail of the weave: off-white anarkali suit in muslin cotton jamdani with booti motifs","width":3000,"height":3000,"src":"/reference-only/products/ksheera-off-white-muslin-cotton-jamdani-suit/08.webp"}],"narrative":"Ksheera is milk, and the whole piece stays inside that one word. The cloth is a jamdani woven in undyed muslin, the booti raised in the same thread as the ground so the pattern is a change in texture rather than in colour — visible when the light moves and almost gone when it does not. It is cut as an anarkali with a gathered fall from a high waist, and left unlined, because a cloth this fine is worth seeing light through.","spec":{"colour":"Undyed off-white","technique":"Jamdani, with tonal booti across the panel","fabric":"Muslin cotton, unlined","speciality":"Self-thread booti — no zari anywhere on the piece","note":"Anarkali with churidar and a matching muslin dupatta."},"provenance":{"workshop":"Lohta workshop","loom":"Pit loom, jamdani","weaveTimeWeeks":6,"artisanCount":2},"garmentType":"suit","weave":"jamdani","fabric":"muslin-cotton","colourFamily":"off-white","zariTypes":["resham"],"motifs":["booti","floral"]}}],"$L2c"]}],"$L2d"]}]}],"$L2e","$L2f"]}]]}]
