21:["$","$L2c",null,{"children":["$","section",null,{"className":"wrap pt-0 pb-0","children":[["$","div",null,{"className":"relative","children":[[["$","div",null,{"className":"relative md:hidden w-full aspect-[3/2] md:aspect-[15/8]","style":{"backgroundColor":"#6E1B24"},"children":["$","$L2d",null,{"src":"/homepage/about/story-banner.jpg","alt":"","fill":true,"sizes":"100vw","priority":false,"quality":90,"className":"object-cover object-center"}]}],["$","div",null,{"className":"relative hidden md:block w-full aspect-[3/2] md:aspect-[15/8]","style":{"backgroundColor":"#6E1B24"},"children":["$","$L2d",null,{"src":"/homepage/about/story-banner.jpg","alt":"","fill":true,"sizes":"(min-width: 1440px) 1600px, 100vw","priority":false,"quality":90,"className":"object-cover object-center"}]}]],["$","$L18",null,{"href":"/pages/handloom","className":"absolute inset-0","style":"$undefined","aria-label":"See more","children":"$undefined"}],null]}],null]}]}]
22:["$","$L2c","story-what-we-are",{"children":["$","section",null,{"className":"section-pad-prose wrap text-left ","style":{"backgroundColor":"var(--color-bg)","backgroundImage":"linear-gradient(180deg, rgba(255,255,255,0), var(--color-bg))"},"children":[null,["$","div",null,{"className":"md:columns-2 md:gap-16","children":[["$","p","0",{"className":"text-body text-ink-body mb-5 last:mb-0","children":"We are a small shop in Banaras selling handwoven cloth from the looms around it. There is no wholesale arm, no second brand, and nothing bought in to fill a gap on a rail."}],["$","p","1",{"className":"text-body text-ink-body mb-5 last:mb-0","children":"Every piece is woven by hand on a pit loom by a weaver we buy from directly, at a price agreed before the warp goes on. We know who made each one and roughly how many weeks it took, and both of those are written on the piece rather than kept for anyone who thinks to ask."}],["$","p","2",{"className":"text-body text-ink-body mb-5 last:mb-0","children":"What that rules out is most of how this trade is normally done. We cannot restock quickly, we cannot discount deeply without taking it out of somebody's hands, and we cannot grow faster than the looms do. Those are real costs and we would rather carry them than sell cloth we cannot account for — a claim nobody is able to check is worth nothing, and it is the weavers who lose most by it."}],["$","p","3",{"className":"text-body text-ink-body mb-5 last:mb-0 italic","children":"Everything Rajraani makes is sold here and in one room in Banaras. Nowhere else."}]]}],null]}]}]
23:["$","$L2c","story-band-name",{"children":["$","section",null,{"className":"wrap section-pad  ","children":["$","div",null,{"className":"grid items-center gap-10 md:grid-cols-2 md:gap-16","children":[["$","div",null,{"className":"md:order-1","children":["$","$L18",null,{"href":"/pages/handloom","className":"group block overflow-hidden","style":"$undefined","aria-label":"Where the name comes from","children":[["$","div",null,{"className":"relative md:hidden w-full aspect-square transition-transform duration-300 ease-[ease-in-out] group-hover:scale-110","style":{"backgroundColor":"#6E1B24"},"children":["$","$L2d",null,{"src":"/homepage/about/story-band-01.jpg","alt":"Where the name comes from","fill":true,"sizes":"100vw","priority":false,"quality":90,"className":"object-cover object-center"}]}],["$","div",null,{"className":"relative hidden md:block w-full aspect-square transition-transform duration-300 ease-[ease-in-out] group-hover:scale-110","style":{"backgroundColor":"#6E1B24"},"children":["$","$L2d",null,{"src":"/homepage/about/story-band-01.jpg","alt":"Where the name comes from","fill":true,"sizes":"(min-width: 1440px) 1600px, 100vw","priority":false,"quality":90,"className":"object-cover object-center"}]}]]}]}],["$","div",null,{"className":"md:order-2","children":[null,["$","h2",null,{"className":"text-h2 mt-3","children":"Where the name comes from"}],["$","div",null,{"className":"mt-5 space-y-4","children":[["$","p","0",{"className":"text-body text-ink-body","children":"Raj is rule and raani is the woman who holds it. Together they are less a claim about royalty than about who a cloth like this was made to be worn by."}],["$","p","1",{"className":"text-body text-ink-body","children":"The word was chosen over a weaving term on purpose. Naming a shop after a technique fixes it to one technique, and the looms we buy from move between nine of them in a year. A saree is not defined by the method that produced it any more than a book is defined by its typeface, and the name should not pretend otherwise."}],["$","p","2",{"className":"text-body text-ink-body","children":"It is also a word almost anyone in north India can say and spell on the first attempt, which matters more than it sounds. A brand nobody can repeat out loud is a brand that travels only by link, and cloth like this has always travelled by recommendation."}]]}],null]}]]}]}]}]
24:["$","$L2c","story-band-philosophy",{"children":["$","section",null,{"className":"wrap section-pad  ","children":["$","div",null,{"className":"grid items-center gap-10 md:grid-cols-2 md:gap-16","children":[["$","div",null,{"className":"md:order-2","children":["$","$L18",null,{"href":"/pages/handloom","className":"group block overflow-hidden","style":"$undefined","aria-label":"What we commission, and what we turn down","children":[["$","div",null,{"className":"relative md:hidden w-full aspect-square transition-transform duration-300 ease-[ease-in-out] group-hover:scale-110","style":{"backgroundColor":"#B08D3F"},"children":["$","$L2d",null,{"src":"/homepage/about/story-band-02.jpg","alt":"What we commission, and what we turn down","fill":true,"sizes":"100vw","priority":false,"quality":90,"className":"object-cover object-center"}]}],["$","div",null,{"className":"relative hidden md:block w-full aspect-square transition-transform duration-300 ease-[ease-in-out] group-hover:scale-110","style":{"backgroundColor":"#B08D3F"},"children":["$","$L2d",null,{"src":"/homepage/about/story-band-02.jpg","alt":"What we commission, and what we turn down","fill":true,"sizes":"(min-width: 1440px) 1600px, 100vw","priority":false,"quality":90,"className":"object-cover object-center"}]}]]}]}],["$","div",null,{"className":"md:order-1","children":[null,["$","h2",null,{"className":"text-h2 mt-3","children":"What we commission, and what we turn down"}],["$","div",null,{"className":"mt-5 space-y-4","children":[["$","p","0",{"className":"text-body text-ink-body","children":"We buy direct, from around forty looms within an hour of the shop, at a price agreed before the warp is set rather than argued after the piece comes off it."}],["$","p","1",{"className":"text-body text-ink-body","children":"The turning down is the harder half. We do not take powerloom at any price, and we do not stock it beside handloom under a softer word. We also refuse work that is technically fine and has nothing to say — a competent copy of a piece somebody else designed forty years ago is the easiest thing in this city to commission and the least worth owning. A commissioned saree is paid for in stages while it is still being woven, because a weaver carrying six months of work cannot also carry six months of our cash flow."}]]}],null]}]]}]}]}]
