0:{"buildId":"YQ6Yg1Co48hoQdaha4lz2","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"data-ends-full-bleed":"","children":[["$","$L2",null,{"children":["$","section",null,{"className":"wrap pt-0 pb-0","children":[["$","div",null,{"className":"relative","children":[[["$","div",null,{"className":"relative md:hidden w-full aspect-[3/2] md:aspect-[15/8]","style":{"backgroundColor":"#6E1B24"},"children":["$","$L3",null,{"src":"/homepage/about/story-banner.jpg","alt":"","fill":true,"sizes":"100vw","priority":false,"quality":90,"className":"object-cover object-center"}]}],["$","div",null,{"className":"relative hidden md:block w-full aspect-[3/2] md:aspect-[15/8]","style":{"backgroundColor":"#6E1B24"},"children":["$","$L3",null,{"src":"/homepage/about/story-banner.jpg","alt":"","fill":true,"sizes":"(min-width: 1440px) 1600px, 100vw","priority":false,"quality":90,"className":"object-cover object-center"}]}]],["$","$L4",null,{"href":"/pages/handloom","className":"absolute inset-0","aria-label":"See more"}],null]}],null]}]}],["$","header",null,{"className":"wrap-prose section-pad text-center","children":["$","header",null,{"className":"cine-page-head cine-page-head--center","children":[null,["$","h1",null,{"className":"cine-page-title cine-page-title--lg","children":"Our story"}],["$","div",null,{"className":"cine-page-head__intro","children":["$","p",null,{"children":"One room in Banaras, about forty looms within an hour of it, and nothing in between."}]}],"$undefined"]}]}],[["$","$L2","story-what-we-are",{"children":["$","section",null,{"className":"ed-rich section-pad-prose wrap text-left ","style":{"backgroundColor":"var(--color-bg)","backgroundImage":"linear-gradient(180deg, transparent, var(--color-bg))"},"children":[null,["$","div",null,{"className":"ed-body md:columns-2 md:gap-16","children":[["$","p","0",{"className":"text-body text-ink-body mb-5 last:mb-0","children":"We are a small shop in Banaras selling handwoven cloth from the looms around it. There is no wholesale arm, no second brand, and nothing bought in to fill a gap on a rail."}],["$","p","1",{"className":"text-body text-ink-body mb-5 last:mb-0","children":"Every piece is woven by hand on a pit loom by a weaver we buy from directly, at a price agreed before the warp goes on. We know who made each one and roughly how many weeks it took, and both of those are written on the piece rather than kept for anyone who thinks to ask."}],["$","p","2",{"className":"text-body text-ink-body mb-5 last:mb-0","children":"What that rules out is most of how this trade is normally done. We cannot restock quickly, we cannot discount deeply without taking it out of somebody's hands, and we cannot grow faster than the looms do. Those are real costs and we would rather carry them than sell cloth we cannot account for — a claim nobody is able to check is worth nothing, and it is the weavers who lose most by it."}],["$","p","3",{"className":"text-body text-ink-body mb-5 last:mb-0 italic","children":"Everything Rajraani makes is sold here and in one room in Banaras. Nowhere else."}]]}],null]}]}],["$","$L2","story-band-name",{"children":["$","section",null,{"className":"wrap section-pad  ","children":["$","div",null,{"className":"grid items-center gap-10 md:grid-cols-2 md:gap-16","children":[["$","div",null,{"className":"ed-media md:order-1","children":["$","$L4",null,{"href":"/pages/handloom","className":"group block overflow-hidden","aria-label":"Where the name comes from","children":[["$","div",null,{"className":"relative md:hidden w-full aspect-square transition-transform duration-300 ease-[ease-in-out] group-hover:scale-110","style":{"backgroundColor":"#6E1B24"},"children":["$","$L3",null,{"src":"/homepage/about/story-band-01.jpg","alt":"Where the name comes from","fill":true,"sizes":"100vw","priority":false,"quality":90,"className":"object-cover object-center"}]}],["$","div",null,{"className":"relative hidden md:block w-full aspect-square transition-transform duration-300 ease-[ease-in-out] group-hover:scale-110","style":{"backgroundColor":"#6E1B24"},"children":"$L5"}]]}]}],"$L6"]}]}]}],"$L7","$L8","$L9"],null]}],["$La","$Lb"],"$Lc"]}],"isPartial":"$@d","staleTime":"$e","varyParams":null},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$e","varyParams":null},{"rsc":"$L11","isPartial":"$@12","staleTime":"$e","varyParams":"$13"},{"rsc":"$L14","isPartial":"$@15","staleTime":"$e","varyParams":"$13"}],"isUpgradeableISRFallback":false,"a":"$@16","rootVaryParams":null,"needsRuntimeRequest":"$@17"}
