1b:["$","$L1f","privacy-what",{"children":["$","section",null,{"className":"ed-rich section-pad-prose wrap-prose text-left ","style":{"backgroundColor":"var(--color-bg)","backgroundImage":"linear-gradient(180deg, transparent, var(--color-bg))"},"children":[["$","h2",null,{"className":"ed-title ed-title--sm text-h3 mb-5","children":"What we collect"}],["$","div",null,{"className":"ed-body space-y-5 ","children":[["$","p","0",{"className":"text-body text-ink-body","children":"To send you an order we need a name, a delivery address, an email address and a telephone number for the courier. If you create an account we keep those so you do not have to type them again."}],["$","p","1",{"className":"text-body text-ink-body","children":"Payment is handled by our payment provider rather than by us. Card details are never on our servers and we never see them."}],["$","p","2",{"className":"text-body text-ink-body","children":"The site records ordinary technical information — pages requested, approximate location from the network address, the kind of device — which is what tells us a page is broken before somebody writes in about it."}]]}],null]}]}]
1c:["$","$L1f","privacy-use",{"children":["$","section",null,{"className":"ed-rich section-pad-prose wrap-prose text-left ","style":{"backgroundColor":"var(--color-bg)","backgroundImage":"linear-gradient(180deg, transparent, var(--color-bg))"},"children":[["$","h2",null,{"className":"ed-title ed-title--sm text-h3 mb-5","children":"What we use it for"}],["$","div",null,{"className":"ed-body space-y-5 ","children":[["$","p","0",{"className":"text-body text-ink-body","children":"Fulfilling your order, answering your messages, and keeping legally required records of what was sold. If you have asked for them, occasional emails about new pieces — and every one of those carries a way out that works."}]]}],null]}]}]
1d:["$","$L1f","privacy-not",{"children":["$","section",null,{"className":"ed-rich section-pad-prose wrap-prose text-left ","style":{"backgroundColor":"var(--color-bg)","backgroundImage":"linear-gradient(180deg, transparent, var(--color-bg))"},"children":[["$","h2",null,{"className":"ed-title ed-title--sm text-h3 mb-5","children":"What we do not do"}],["$","div",null,{"className":"ed-body space-y-5 ","children":[["$","p","0",{"className":"text-body text-ink-body","children":"We do not sell your details, rent them, or pass them to anybody whose job is advertising. The only third parties who receive anything are the ones who have to: the payment provider, the courier, and the service that sends our email."}]]}],null]}]}]
1e:["$","$L1f","privacy-rights",{"children":["$","section",null,{"className":"ed-rich section-pad-prose wrap-prose text-left ","style":{"backgroundColor":"var(--color-bg)","backgroundImage":"linear-gradient(180deg, transparent, var(--color-bg))"},"children":[["$","h2",null,{"className":"ed-title ed-title--sm text-h3 mb-5","children":"Asking us to delete it"}],["$","div",null,{"className":"ed-body space-y-5 ","children":[["$","p","0",{"className":"text-body text-ink-body","children":"Write and ask. We will tell you what we hold, correct it, or delete it — except the parts tax law requires us to keep, which we will name rather than hide behind."}]]}],["$","div",null,{"className":"mt-6","children":["$","$L20",null,{"href":"/pages/contact","className":"cta-link","children":"Write to us"}]}]]}]}]
