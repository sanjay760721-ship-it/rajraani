1b:["$","$L1c","faq-groups",{"children":["$","section",null,{"className":"wrap section-pad","children":[["$","div","Product",{"className":"mb-12 last:mb-0","children":[["$","h2",null,{"className":"text-h3 mb-3 text-ink","children":"Product"}],["$","dl",null,{"children":[["$","div","How can I find out more about a piece?",{"className":"border-b border-rule","children":["$","details",null,{"className":"group py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center gap-4","children":[["$","svg",null,{"aria-hidden":true,"viewBox":"0 0 24 24","className":"h-4 w-4 shrink-0 text-ink transition-transform duration-300 group-open:rotate-180","fill":"none","stroke":"currentColor","strokeWidth":"1.5","strokeLinecap":"round","strokeLinejoin":"round","children":["$","path",null,{"d":"M5 9l7 7 7-7"}]}],["$","dt",null,{"className":"text-body text-ink","children":"How can I find out more about a piece?"}]]}],["$","dd",null,{"className":"text-body mt-3 pl-8 text-ink-body","children":"Every product page carries the technique, the fabric, the zari, the colour and roughly how many weeks the piece sat on the loom. If you want more than that, write to us — we can usually tell you which loom it came off and what else that weaver is working on."}]]}]}],["$","div","Will it look like the photograph?",{"className":"border-b border-rule","children":["$","details",null,{"className":"group py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center gap-4","children":[["$","svg",null,{"aria-hidden":true,"viewBox":"0 0 24 24","className":"h-4 w-4 shrink-0 text-ink transition-transform duration-300 group-open:rotate-180","fill":"none","stroke":"currentColor","strokeWidth":"1.5","strokeLinecap":"round","strokeLinejoin":"round","children":["$","path",null,{"d":"M5 9l7 7 7-7"}]}],["$","dt",null,{"className":"text-body text-ink","children":"Will it look like the photograph?"}]]}],["$","dd",null,{"className":"text-body mt-3 pl-8 text-ink-body","children":"Close, not identical. Silk takes light differently at every angle, which is most of why it is worth owning and most of why it is hard to photograph. Screens vary too. If an exact shade matters, ask us to describe it against something you already own, or ask for a photograph in daylight."}]]}]}],["$","div","Is the zari real?",{"className":"border-b border-rule","children":["$","details",null,{"className":"group py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center gap-4","children":[["$","svg",null,{"aria-hidden":true,"viewBox":"0 0 24 24","className":"h-4 w-4 shrink-0 text-ink transition-transform duration-300 group-open:rotate-180","fill":"none","stroke":"currentColor","strokeWidth":"1.5","strokeLinecap":"round","strokeLinejoin":"round","children":["$","path",null,{"d":"M5 9l7 7 7-7"}]}],["$","dt",null,{"className":"text-body text-ink","children":"Is the zari real?"}]]}],["$","dd",null,{"className":"text-body mt-3 pl-8 text-ink-body","children":"It is stated per piece, because it is a fact about that piece rather than about the shop. Real zari is silver thread with a gold finish wound on silk: heavier than the substitute, warm rather than cool in the hand, and it tarnishes slowly instead of flaking within a year."}]]}]}],["$","div","How do I look after a saree?",{"className":"border-b border-rule","children":["$","details",null,{"className":"group py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center gap-4","children":[["$","svg",null,{"aria-hidden":true,"viewBox":"0 0 24 24","className":"h-4 w-4 shrink-0 text-ink transition-transform duration-300 group-open:rotate-180","fill":"none","stroke":"currentColor","strokeWidth":"1.5","strokeLinecap":"round","strokeLinejoin":"round","children":["$","path",null,{"d":"M5 9l7 7 7-7"}]}],["$","dt",null,{"className":"text-body text-ink","children":"How do I look after a saree?"}]]}],["$","dd",null,{"className":"text-body mt-3 pl-8 text-ink-body","children":"Dry clean only, and as rarely as you can stand. Store it folded in cotton rather than plastic, refold along different lines once a year so the creases do not become cuts, and keep it out of direct sun, which takes the colour out of silk faster than wearing it does."}]]}]}],"$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]]}],"$L23","$L24","$L25","$L26","$L27"]}]}]
1d:["$","div","How do I look after a metal piece?",{"className":"border-b border-rule","children":["$","details",null,{"className":"group py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center gap-4","children":[["$","svg",null,{"aria-hidden":true,"viewBox":"0 0 24 24","className":"h-4 w-4 shrink-0 text-ink transition-transform duration-300 group-open:rotate-180","fill":"none","stroke":"currentColor","strokeWidth":"1.5","strokeLinecap":"round","strokeLinejoin":"round","children":["$","path",null,{"d":"M5 9l7 7 7-7"}]}],["$","dt",null,{"className":"text-body text-ink","children":"How do I look after a metal piece?"}]]}],["$","dd",null,{"className":"text-body mt-3 pl-8 text-ink-body","children":"Dust it dry. Brass will darken over years, which is the point of brass; if you would rather it did not, a wipe with a soft cloth every few months slows it. Never use an abrasive or a household metal polish on repoussé — the relief is the thinnest part of the sheet and polish takes it away first."}]]}]}]
1e:["$","div","Do sarees come with a blouse piece?",{"className":"border-b border-rule","children":["$","details",null,{"className":"group py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center gap-4","children":[["$","svg",null,{"aria-hidden":true,"viewBox":"0 0 24 24","className":"h-4 w-4 shrink-0 text-ink transition-transform duration-300 group-open:rotate-180","fill":"none","stroke":"currentColor","strokeWidth":"1.5","strokeLinecap":"round","strokeLinejoin":"round","children":["$","path",null,{"d":"M5 9l7 7 7-7"}]}],["$","dt",null,{"className":"text-body text-ink","children":"Do sarees come with a blouse piece?"}]]}],["$","dd",null,{"className":"text-body mt-3 pl-8 text-ink-body","children":"Where one was woven to go with the saree, yes, and the product page says so. Where it was not we will not cut one off the end of the piece to fake it — that shortens the saree and is a common and quiet way of doing it."}]]}]}]
1f:["$","div","I have a design. Can you have it woven?",{"className":"border-b border-rule","children":["$","details",null,{"className":"group py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center gap-4","children":[["$","svg",null,{"aria-hidden":true,"viewBox":"0 0 24 24","className":"h-4 w-4 shrink-0 text-ink transition-transform duration-300 group-open:rotate-180","fill":"none","stroke":"currentColor","strokeWidth":"1.5","strokeLinecap":"round","strokeLinejoin":"round","children":["$","path",null,{"d":"M5 9l7 7 7-7"}]}],["$","dt",null,{"className":"text-body text-ink","children":"I have a design. Can you have it woven?"}]]}],["$","dd",null,{"className":"text-body mt-3 pl-8 text-ink-body","children":"Sometimes. Send it and we will tell you honestly whether it suits a Banarasi loom, what it would cost and how long it would take. A drawn curve has to be resolved into steps the loom can execute, and some designs come out of that process worse than they went in."}]]}]}]
