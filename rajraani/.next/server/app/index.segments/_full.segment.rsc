5:["$","$L19",null,{"scenes":[{"kind":"slides","id":"homepage-hero-carousel","transition":"fade","isPageTitle":true,"slides":[{"id":"slide-antaraal","kicker":"Roman Frescoes","title":"Antaraal","body":"Gheecha silk worked against a katan ground, so the surface takes light unevenly and never twice the same way.","cta":{"label":"Discover","href":"/collections/antaraal"},"image":"/homepage/hero/slide-01-antaraal.webp","mobileImage":"/homepage/hero/slide-01-antaraal.webp","align":"right"},{"id":"slide-nadi","kicker":"Handloom Day","title":"Nadi","body":"Nine pieces built outward from one motif at the centre of the pallu, and read from there.","cta":{"label":"Discover","href":"/pages/nadi"},"image":"/homepage/hero/slide-02-nadi.webp","mobileImage":"/homepage/hero/slide-02-nadi.webp","align":"right"},{"id":"slide-kadhua","kicker":"Seasonal Edit","title":"Kadhua","body":"Undyed grounds and real zari, in the lighter weights a long afternoon asks for.","cta":{"label":"Discover","href":"/collections/kadhua"},"image":"/homepage/hero/slide-03-kadhua.webp","mobileImage":"/homepage/hero/slide-03-kadhua.webp","align":"left"},{"id":"slide-gifting","kicker":"Curated Edits","title":"The Art of Gifting","body":"Thoughtfully handwoven pieces for timeless celebrations.","cta":{"label":"Explore Gifts","href":"/collections/gifts"},"image":"/homepage/hero/slide-04-gifting.webp","mobileImage":"/homepage/hero/slide-04-gifting.webp","align":"right"},{"id":"slide-art-collectibles","kicker":"Metalwork","title":"Art & Collectibles","body":"Heirloom metal repoussé and master artisan collectibles.","cta":{"label":"Discover","href":"/pages/art-collectibles"},"image":"/homepage/hero/slide-05-art-collectibles.webp","mobileImage":"/homepage/hero/slide-05-art-collectibles.webp","align":"left"}]},{"kind":"story","id":"triptych-antaraal","statement":{"quote":"Every piece is one piece.","body":"We buy directly from weavers in and around Varanasi, and we make one of a thing. When it sells, it is rewoven or it is not made again."},"photos":[{"image":"/homepage/gallery/tile-01.webp","href":"/products/sindoor-red-katan-silk-kadiyal-saree"},{"image":"/homepage/gallery/tile-02.webp","href":"/products/chandrika-ivory-tissue-silk-jangla-saree"},{"image":"/homepage/gallery/tile-03.webp","href":"/products/padmini-pink-moonga-silk-anarkali-suit"}],"title":"Antaraal","body":"Gheecha is spun from the short, uneven fibres left after the reel, which is why it will not lie flat and why the light never settles on it. Woven into a katan ground it gives a surface with grain in it.","cta":{"label":"Discover","href":"/collections/antaraal"},"secondary":{"label":"Shop the pieces","href":"/collections/antaraal"},"kicker":"The collection"},{"kind":"film","id":"loom-video","kicker":"Handloom heritage","title":"The Motion of the Loom","body":"Between six and twenty-six weeks on a pit loom in Varanasi. Every thread guided by human hand.","cta":{"label":"Watch Our Process","href":"/pages/handloom"},"image":"/homepage/video/loom-poster.webp","video":"/homepage/video/loom.mp4","facts":[{"figure":"6–26","label":"Weeks on the loom"},{"figure":"By hand","label":"Every thread"},{"figure":"Varanasi","label":"Where it is woven"}]},{"kind":"shop","id":"shop","items":[{"id":"SAREES","title":"Sarees","kicker":"Shop","href":"/collections/sarees","image":"/homepage/category/sarees.webp"},{"id":"SUITS","title":"Suits","kicker":"Shop","href":"/collections/suits","image":"/homepage/category/suits-b.webp"},{"id":"slide-womenswear","title":"Womenswear","kicker":"Shop","body":"Sarees, dupattas and stitched pieces, all off the same looms.","href":"/collections/all","image":"/homepage/womens-mens/womenswear.webp","focus":"27% 45%"},{"id":"slide-menswear","title":"Stoles","kicker":"For him","body":"Handwoven stoles that sit as well over a kurta as over a saree.","href":"/collections/stoles","image":"/homepage/womens-mens/menswear.webp","focus":"27% 45%"}]},{"kind":"edits","id":"quick-links","kicker":"For the occasion","title":"Curated edits","note":"Bridal, gifting, real zari and repoussé, each chosen piece by piece.","items":[{"label":"Bridal","href":"/collections/bridal","image":"/homepage/four-tiles/tile-01-bridal.webp"},{"label":"Gifting","href":"/collections/gifts","image":"/homepage/four-tiles/tile-02-gifting.webp"},{"label":"Zarkashi","href":"/collections/sarees?zari=real_zari","image":"/homepage/four-tiles/tile-03-zarkashi.webp"},{"label":"Repoussé","href":"/pages/art-collectibles","image":"/homepage/four-tiles/tile-04-art-collectibles.webp"}]},{"kind":"slides","id":"campaign-slideshow","transition":"wipe","slides":[{"id":"slide-kala","kicker":"Campaign","title":"Kala","body":"Kala is craft with nothing ranked above anything else — the loom, the brush and the chisel under one word. These are the pieces where the weaving leans hardest on the other three, and where a weaver has clearly been looking at something that was not cloth.","cta":{"label":"Discover","href":"/pages/kala"},"secondary":{"label":"Shop the pieces","href":"/collections/all"},"image":"/homepage/campaign/kala.webp","align":"left"},{"id":"slide-awadh","kicker":"Campaign","title":"Awadh","body":"A hundred and twenty miles upriver, ornament is done in thread rather than in metal, and a single spray is trusted to carry a whole width. These were commissioned after a week of looking at it, which is a hard thing to walk out of and then ask for more zari.","cta":{"label":"Discover","href":"/pages/awadh"},"secondary":{"label":"Shop the pieces","href":"/collections/all"},"image":"/homepage/campaign/charbagh.webp","align":"left"}]},{"kind":"words","id":"closing-thought","title":"Cloth that keeps time","body":"A saree outlives the season it was bought for, and often the person who chose it. That is the argument for weaving slowly and for buying once — a cupboard in this country is a form of archive, and what goes into it should still be worth taking out in twenty years."},{"kind":"slides","id":"stores-banaras-lucknow","transition":"fade","slides":[{"id":"slide-varanasi","kicker":"Visit our stores","title":"Banaras","body":"The Banaras room is ten minutes from the looms we buy from. Come and see cloth in daylight, over a shoulder, before deciding anything.","cta":{"label":"Book a visit","href":"https://calendly.com/rajraani-banaras/visit-to-the-rajraani-experience-centre-varanasi"},"image":"/homepage/stores/varanasi.webp","align":"left"},{"id":"slide-lucknow","kicker":"Visit our stores","title":"Lucknow","body":"An appointment, an afternoon, and as many pieces off the shelf as you care to see. Nothing here is sold in a hurry.","cta":{"label":"Book a visit","href":"https://calendly.com/rajraani-banaras/visit-to-the-rajraani-store-lucknow"},"image":"/homepage/stores/lucknow.webp","align":"left"}]}],"menu":"$4:props:children:props:value","footer":{"newsletterHeading":"Stay in touch","newsletterText":"Occasional letters about what has come off the loom.","newsletterButton":"Sign Up","email":"orders@example.invalid","phone":"+91 00000 00000","talkHeading":"Talk To Us","whatsappLabel":"Start a WhatsApp conversation","hoursLabel":"Support hours:","columns":"$10:props:children:props:children:props:children:props:children:3:props:settings:columns","socials":"$10:props:children:props:children:props:children:props:children:3:props:settings:socials","hours":["Monday to Friday, 10:00–19:00 IST","Saturday, 10:00–16:00 IST"],"legalName":"Rajraani Handloom Private Limited"}}]
a:[["$","meta","0",{"charSet":"utf-8"}],["$","meta","1",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]
