4:["$","$L12",null,{"value":{"announce.1":"Complimentary shipping across India","announce.2":"Handwoven in Varanasi, one piece at a time","announce.3":"Visit us in Banaras by appointment","tagline":"Made in Banaras. Made by Rajraani.","contact.email":"orders@example.invalid","contact.phone":"+91 00000 00000","contact.hours":"Monday to Friday, 10:00–19:00 IST\nSaturday, 10:00–16:00 IST","product.promise":"Pure. Handloom. Banaras.","product.handmadeNote":"Woven entirely by hand, so no two pieces are identical and small irregularities are part of the record of making.","product.tab.shipping.label":"Shipping","product.tab.shipping.lines":"Dispatched from Varanasi with a tracking number sent on despatch.\nDelivery within India takes 3–5 working days.\nShipping within India is complimentary, with no minimum.\nWe ship within India only at present. For enquiries from elsewhere, please write to us.","product.tab.dimensions.label":"Dimensions","product.tab.dimensions.lines":"Saree — 5.5 m × 1.1 m, with an unstitched blouse piece of 0.8 m.\nDupatta — 2.4 m × 1.0 m.\nStole — 2.2 m × 0.7 m.\nEvery piece is woven to order, so dimensions may vary very slightly.","product.tab.care.label":"Care","product.tab.care.lines":"Store folded in muslin, away from sunlight, damp and dust.\nAir and refold every few months so the folds do not set.\nDry clean only, and only when it is genuinely needed.\nKeep perfume and a hot iron off the zari.","product.tab.other.label":"Other","product.tab.other.lines":"Manufactured and marketed by Rajraani Handloom Private Limited, Varanasi, Uttar Pradesh, India.\nCountry of origin: India.\nFor queries, write to orders@example.invalid or call +91 00000 00000."},"children":["$","$L13",null,{"value":[{"id":"shop","label":"Shop","href":"/collections/sarees","links":[{"label":"Sarees","href":"/collections/sarees"},{"label":"Suits","href":"/collections/suits"},{"label":"Fresh Off the Loom","href":"/collections/fresh-off-the-loom"},{"label":"Ready to Ship","href":"